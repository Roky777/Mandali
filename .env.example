# Export these variables in your shell; Django does not auto-load this file.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required with DEBUG=0. Generate a random value; never commit it.
# DJANGO_SECRET_KEY=
MANDALI_BASE_URL=http://127.0.0.1:8000
# Development only: reset and invitation emails appear in the server terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Mandali <noreply@example.com>
# For real delivery, configure SMTP and use the smtp backend.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# Google Cloud production (see docs/GOOGLE_CLOUD.md):
# CLOUD_SQL_CONNECTION_NAME=project-id:asia-south1:mandali-db
# DB_NAME=mandali
# DB_USER=mandali_app
# DB_PASSWORD=<injected by Secret Manager>
# DJANGO_TRUST_CLOUD_RUN_PROXY=1
# DJANGO_TRUSTED_PROXY_HOPS=0
# For local PostgreSQL testing instead of a Cloud SQL socket:
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Required for sandbox payment links/credentials. Generate a Fernet key and
# inject it through Secret Manager; never commit its value.
# PAYMENT_ENCRYPTION_KEYS=<current-fernet-key>,<optional-old-fernet-key>
# Development only (ignored unless DJANGO_DEBUG=1): let webhooks and website
# sync reach a sample website on localhost over http.
# MANDALI_ALLOW_LOCAL_INTEGRATIONS=1
